# Copy to .env and adjust. Every variable the app reads is listed here and in the README.

# --- App ---
# keep :8080 under Compose
LISTEN_ADDR=:8080
SESSION_MAX_AGE=14d
# set true behind HTTPS
SECURE_COOKIE=false
# Direct (non-proxied) callers allowed to use backup-all; empty = disabled (checked against the direct TCP peer)
# BACKUP_ALL_ALLOWED_IPS=
# Compose builds DATABASE_URL from the POSTGRES_* values below. Set it yourself only when
# running outside Compose (the password must be URL-safe):
# DATABASE_URL=postgres://passman:<password>@<db-host>:5432/passman?sslmode=disable

# --- Compose ---
# Postgres container. REQUIRED: set POSTGRES_PASSWORD BEFORE the first start (Compose refuses
# to start without it, and it is fixed once the pg-data volume exists).
# Use letters and digits only: it is embedded in DATABASE_URL.
POSTGRES_USER=passman
POSTGRES_PASSWORD=
POSTGRES_DB=passman
# IMAGE=eacer/passman:v1.0   # pin a release; default eacer/passman:latest
# APP_BIND=127.0.0.1   # publish on loopback only when a proxy fronts the app
# APP_PORT=8080
